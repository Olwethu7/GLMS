@model GLMS.Models.Client

@{
    ViewData["Title"] = "Client Details";
}

<div class="container">
    <div class="row">
        <div class="col-md-8 mx-auto">
            <div class="card shadow">
                <div class="card-header bg-info text-white">
                    <h3><i class="bi bi-building"></i> Client Details</h3>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-3">Name</dt>
                        <dd class="col-sm-9">@Model.Name</dd>

                        <dt class="col-sm-3">Email</dt>
                        <dd class="col-sm-9">@Model.Email</dd>

                        <dt class="col-sm-3">Phone</dt>
                        <dd class="col-sm-9">@Model.Phone</dd>

                        <dt class="col-sm-3">Address</dt>
                        <dd class="col-sm-9">@Model.Address</dd>

                        <dt class="col-sm-3">Region</dt>
                        <dd class="col-sm-9">@Model.Region</dd>

                        <dt class="col-sm-3">Tax ID</dt>
                        <dd class="col-sm-9">@(Model.TaxId ?? "N/A")</dd>

                        <dt class="col-sm-3">Status</dt>
                        <dd class="col-sm-9">
                            @if (Model.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Inactive</span>
                            }
                        </dd>

                        <dt class="col-sm-3">Created Date</dt>
                        <dd class="col-sm-9">@Model.CreatedAt.ToString("f")</dd>

                        <dt class="col-sm-3">Contracts</dt>
                        <dd class="col-sm-9">
                            <span class="badge bg-primary">@Model.Contracts.Count Contracts</span>
                        </dd>
                    </dl>

                    <hr />

                    <h5>Contracts</h5>
                    @if (Model.Contracts.Any())
                    {
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Reference</th>
                                    <th>Start Date</th>
                                    <th>End Date</th>
                                    <th>Status</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var contract in Model.Contracts)
                                {
                                    <tr>
                                        <td>@contract.ContractReference</td>
                                        <td>@contract.StartDate.ToShortDateString()</td>
                                        <td>@contract.EndDate.ToShortDateString()</td>
                                        <td>@contract.Status</td>
                                        <td>
                                            <a asp-controller="Contracts" asp-action="Details" asp-route-id="@contract.Id" class="btn btn-sm btn-info">View</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <p class="text-muted">No contracts for this client.</p>
                    }

                    <div class="mt-3 d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
                        <div>
                            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
                            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">Delete</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>