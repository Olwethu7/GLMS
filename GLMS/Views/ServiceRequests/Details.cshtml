@model GLMS.Models.ServiceRequest

@{
    ViewData["Title"] = "Service Request Details";
}

<div class="container">
    <div class="row">
        <div class="col-md-8 mx-auto">
            <div class="card shadow">
                <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
                    <h3><i class="bi bi-receipt"></i> Service Request Details</h3>
                    <span class="badge bg-light text-dark fs-6">@Model.TrackingNumber</span>
                </div>
                <div class="card-body">

                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="bi bi-check-circle-fill"></i> @TempData["Success"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="bi bi-exclamation-triangle-fill"></i> @TempData["Error"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <!-- Information Card -->
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <div class="card bg-light">
                                <div class="card-body">
                                    <h6 class="card-subtitle mb-2 text-muted">Request Information</h6>
                                    <p class="card-text">
                                        <strong>ID:</strong> #@Model.Id<br />
                                        <strong>Tracking:</strong> @Model.TrackingNumber<br />
                                        <strong>Created:</strong> @Model.CreatedAt.ToString("g")<br />
                                        <strong>Status:</strong>
                                        <span class="badge bg-@(Model.Status == RequestStatus.Completed ? "success" :
                                                                                                       Model.Status == RequestStatus.Approved ? "info" :
                                                                                                       Model.Status == RequestStatus.InProgress ? "primary" :
                                                                                                       Model.Status == RequestStatus.Cancelled ? "danger" :
                                                                                                       Model.Status == RequestStatus.OnHold ? "warning" : "secondary")">
                                            @Model.Status
                                        </span>
                                    </p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="card bg-light">
                                <div class="card-body">
                                    <h6 class="card-subtitle mb-2 text-muted">Contract & Client</h6>
                                    <p class="card-text">
                                        <strong>Contract:</strong>
                                        <a asp-controller="Contracts" asp-action="Details" asp-route-id="@Model.ContractId">
                                            @Model.Contract?.ContractReference
                                        </a><br />
                                        <strong>Client:</strong> @Model.Contract?.Client?.Name<br />
                                        <strong>Region:</strong> @Model.Contract?.Client?.Region
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Details Table -->
                    <table class="table table-bordered">
                        <tr>
                            <th style="width: 30%; background-color: #f8f9fa;">Description</th>
                            <td colspan="3">@Model.Description</td>
                        </tr>
                        <tr>
                            <th style="background-color: #f8f9fa;">Amount (USD)</th>
                            <td>$ @Model.AmountUSD.ToString("N2")</td>
                            <th style="background-color: #f8f9fa;">Amount (ZAR)</th>
                            <td>R @Model.AmountZAR.ToString("N2")</td>
                        </tr>
                        <tr>
                            <th style="background-color: #f8f9fa;">Exchange Rate</th>
                            <td colspan="3">1 USD = @Model.ExchangeRateUsed.ToString("N4") ZAR</td>
                        </tr>
                        <tr>
                            <th style="background-color: #f8f9fa;">Priority</th>
                            <td>
                                <span class="badge bg-@(Model.Priority == PriorityLevel.High ? "danger" :
                                                                                       Model.Priority == PriorityLevel.Medium ? "warning" : "success")">
                                    @Model.Priority
                                </span>
                            </td>
                            <th style="background-color: #f8f9fa;">Request Date</th>
                            <td>@Model.RequestDate.ToString("f")</td>
                        </tr>
                        @if (Model.RequiredByDate.HasValue)
                        {
                            <tr>
                                <th style="background-color: #f8f9fa;">Required By Date</th>
                                <td colspan="3">
                                    @Model.RequiredByDate.Value.ToShortDateString()
                                    @if (Model.RequiredByDate.Value < DateTime.UtcNow && Model.Status != RequestStatus.Completed)
                                    {
                                        <span class="badge bg-danger ms-2">OVERDUE!</span>
                                    }
                                </td>
                            </tr>
                        }
                        @if (!string.IsNullOrEmpty(Model.SpecialInstructions))
                        {
                            <tr>
                                <th style="background-color: #f8f9fa;">Special Instructions</th>
                                <td colspan="3">@Model.SpecialInstructions</td>
                            </tr>
                        }
                        @if (!string.IsNullOrEmpty(Model.InternalNotes))
                        {
                            <tr>
                                <th style="background-color: #f8f9fa;">Internal Notes</th>
                                <td colspan="3">@Model.InternalNotes</td>
                            </tr>
                        }
                        @if (Model.CompletedAt.HasValue)
                        {
                            <tr>
                                <th style="background-color: #f8f9fa;">Completed At</th>
                                <td colspan="3">@Model.CompletedAt.Value.ToString("f")</td>
                            </tr>
                        }
                    </table>

                    <hr />

                    <!-- Status Update Form - FULLY CORRECTED -->
                    <div class="card mt-3 border-primary">
                        <div class="card-header bg-primary text-white">
                            <h5 class="mb-0"><i class="bi bi-arrow-repeat"></i> Update Request Status</h5>
                        </div>
                        <div class="card-body">
                            <form asp-action="UpdateStatus" asp-route-id="@Model.Id" method="post">
                                @Html.AntiForgeryToken()
                                <div class="row align-items-end">
                                    <div class="col-md-8">
                                        <label class="form-label fw-bold">Select New Status</label>
                                        <select name="status" class="form-select form-select-lg">
                                            <option value="Pending" selected="@(Model.Status == RequestStatus.Pending)">⏳ Pending</option>
                                            <option value="Approved" selected="@(Model.Status == RequestStatus.Approved)">✓ Approved</option>
                                            <option value="InProgress" selected="@(Model.Status == RequestStatus.InProgress)">🔄 In Progress</option>
                                            <option value="Completed" selected="@(Model.Status == RequestStatus.Completed)">✅ Completed</option>
                                            <option value="Cancelled" selected="@(Model.Status == RequestStatus.Cancelled)">❌ Cancelled</option>
                                            <option value="OnHold" selected="@(Model.Status == RequestStatus.OnHold)">⚠️ On Hold</option>
                                        </select>
                                    </div>
                                    <div class="col-md-4">
                                        <button type="submit" class="btn btn-primary w-100 btn-lg">
                                            <i class="bi bi-save"></i> Update Status
                                        </button>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>

                    <!-- Status History Timeline (Advanced Feature) -->
                    <div class="card mt-3">
                        <div class="card-header bg-secondary text-white">
                            <h5 class="mb-0"><i class="bi bi-clock-history"></i> Status Timeline</h5>
                        </div>
                        <div class="card-body">
                            <div class="timeline">
                                <div class="timeline-item">
                                    <div class="timeline-badge bg-success">
                                        <i class="bi bi-check-circle"></i>
                                    </div>
                                    <div class="timeline-content">
                                        <p class="mb-0"><strong>Request Created</strong></p>
                                        <small class="text-muted">@Model.CreatedAt.ToString("f")</small>
                                    </div>
                                </div>
                                @if (Model.CompletedAt.HasValue)
                                {
                                    <div class="timeline-item">
                                        <div class="timeline-badge bg-info">
                                            <i class="bi bi-flag-checkered"></i>
                                        </div>
                                        <div class="timeline-content">
                                            <p class="mb-0"><strong>Completed</strong></p>
                                            <small class="text-muted">@Model.CompletedAt.Value.ToString("f")</small>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="mt-4 d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-arrow-left"></i> Back to List
                        </a>
                        <div>
                            @if (Model.Status != RequestStatus.Completed && Model.Status != RequestStatus.Cancelled)
                            {
                                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning me-2">
                                    <i class="bi bi-pencil"></i> Edit Request
                                </a>
                            }
                            <button type="button" class="btn btn-outline-primary" onclick="window.print();">
                                <i class="bi bi-printer"></i> Print
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .timeline {
        position: relative;
        padding-left: 30px;
    }

    .timeline-item {
        position: relative;
        margin-bottom: 20px;
    }

    .timeline-badge {
        position: absolute;
        left: -30px;
        top: 0;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
    }

    .timeline-content {
        padding-left: 20px;
        border-left: 2px solid #dee2e6;
        padding-bottom: 10px;
    }

    .timeline-item:last-child .timeline-content {
        border-left: none;
    }
</style>