@model IEnumerable<GLMS.Models.ServiceRequest>

@{
    ViewData["Title"] = "Service Requests";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>
            <i class="bi bi-truck"></i> Service Requests
        </h1>
        <a asp-action="Create" class="btn btn-primary btn-lg">
            <i class="bi bi-plus-circle"></i> New Service Request
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Warning"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill"></i> @TempData["Warning"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>Tracking #</th>
                            <th>Contract</th>
                            <th>Client</th>
                            <th>Description</th>
                            <th>Amount (USD)</th>
                            <th>Amount (ZAR)</th>
                            <th>Status</th>
                            <th>Priority</th>
                            <th>Request Date</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            var statusClass = item.Status switch
                            {
                                RequestStatus.Completed => "success",
                                RequestStatus.Approved => "info",
                                RequestStatus.InProgress => "primary",
                                RequestStatus.Cancelled => "danger",
                                RequestStatus.OnHold => "warning",
                                _ => "secondary"
                            };

                            var priorityClass = item.Priority switch
                            {
                                PriorityLevel.High => "danger",
                                PriorityLevel.Medium => "warning",
                                _ => "success"
                            };

                            <tr>
                                <td>
                                    <strong>@item.TrackingNumber</strong>
                                    <br />
                                    <small class="text-muted">ID: @item.Id</small>


                                <td>@item.Contract?.ContractReference</td>
                                <td>@item.Contract?.Client?.Name</td>
                                <td style="max-width: 200px; overflow: hidden; text-overflow: ellipsis;">
                                    @(item.Description.Length > 50 ? item.Description.Substring(0, 50) + "..." : item.Description)


                                <td>$ @item.AmountUSD.ToString("N2")</td>
                                <td>R @item.AmountZAR.ToString("N2")</td>


                                <span class="badge bg-@statusClass">@item.Status</span>


                                <span class="badge bg-@priorityClass">@item.Priority</span>


                                @item.RequestDate.ToShortDateString()


                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">
                                    <i class="bi bi-eye"></i>
                                </a>
                                @if (item.Status != RequestStatus.Completed && item.Status != RequestStatus.Cancelled)
                                {
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                }

                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (!Model.Any())
            {
                <div class="alert alert-info text-center">
                    <i class="bi bi-info-circle"></i> No service requests found.
                    <a asp-action="Create" class="alert-link">Create your first service request</a>
                </div>
            }
        </div>
    </div>
</div>