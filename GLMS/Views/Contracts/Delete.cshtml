@model GLMS.Models.Contract

@{
    ViewData["Title"] = "Delete Contract";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-danger text-white">
                    <h3><i class="bi bi-exclamation-triangle"></i> Delete Contract</h3>
                </div>
                <div class="card-body">
                    <div class="alert alert-warning">
                        <i class="bi bi-info-circle"></i> Are you sure you want to delete this contract?
                        <strong>This action cannot be undone!</strong>
                    </div>

                    <dl class="row">
                        <dt class="col-sm-4">Reference</dt>
                        <dd class="col-sm-8">@Model.ContractReference</dd>

                        <dt class="col-sm-4">Client</dt>
                        <dd class="col-sm-8">@Model.Client?.Name</dd>

                        <dt class="col-sm-4">Period</dt>
                        <dd class="col-sm-8">@Model.StartDate.ToShortDateString() - @Model.EndDate.ToShortDateString()</dd>

                        <dt class="col-sm-4">Status</dt>
                        <dd class="col-sm-8">@Model.Status</dd>

                        <dt class="col-sm-4">Service Requests</dt>
                        <dd class="col-sm-8">@(Model.ServiceRequests?.Count ?? 0)</dd>
                    </dl>

                    @if (Model.ServiceRequests != null && Model.ServiceRequests.Any())
                    {
                        <div class="alert alert-danger">
                            <i class="bi bi-ban"></i> Cannot delete contract with existing service requests.
                            Please delete or reassign service requests first.
                        </div>
                    }

                    <form asp-action="Delete">
                        <input type="hidden" asp-for="Id" />
                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                            <button type="submit" class="btn btn-danger" @(Model.ServiceRequests != null && Model.ServiceRequests.Any() ? "disabled" : "")>
                                <i class="bi bi-trash"></i> Confirm Delete
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>