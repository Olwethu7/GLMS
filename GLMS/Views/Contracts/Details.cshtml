@model GLMS.Models.Contract

@{
    ViewData["Title"] = "Contract Details";
}

<div class="container">
    <div class="row">
        <div class="col-md-8 mx-auto">
            <div class="card shadow">
                <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
                    <h3><i class="bi bi-file-earmark-text"></i> Contract Details</h3>
                    <span class="badge bg-light text-dark">@Model.ContractReference</span>
                </div>
                <div class="card-body">

                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="bi bi-check-circle-fill"></i> @TempData["Success"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <!-- Status Banner -->
                    <div class="alert alert-@(Model.GetStatusColor()) mb-4">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <strong>Status:</strong> @Model.Status
                                @if (Model.IsActive())
                                {
                                    <span class="badge bg-success ms-2">Active ✓</span>
                                }
                                @if (Model.GetRemainingDays() > 0 && Model.Status == ContractStatus.Active)
                                {
                                    <span class="badge bg-warning text-dark ms-2">Expires in @Model.GetRemainingDays() days</span>
                                }
                            </div>
                            @if (Model.CanCreateServiceRequest())
                            {
                                <a asp-controller="ServiceRequests" asp-action="Create" class="btn btn-sm btn-light">
                                    <i class="bi bi-plus-circle"></i> New Service Request
                                </a>
                            }
                        </div>
                    </div>

                    <dl class="row">
                        <dt class="col-sm-4">Contract Reference</dt>
                        <dd class="col-sm-8"><strong>@Model.ContractReference</strong></dd>

                        <dt class="col-sm-4">Client</dt>
                        <dd class="col-sm-8">
                            <a asp-controller="Clients" asp-action="Details" asp-route-id="@Model.ClientId">
                                @Model.Client?.Name
                            </a>
                        </dd>

                        <dt class="col-sm-4">Start Date</dt>
                        <dd class="col-sm-8">@Model.StartDate.ToShortDateString()</dd>

                        <dt class="col-sm-4">End Date</dt>
                        <dd class="col-sm-8">@Model.EndDate.ToShortDateString()</dd>

                        <dt class="col-sm-4">Service Level</dt>
                        <dd class="col-sm-8">
                            @if (Model.ServiceLevel == ServiceLevel.Enterprise)
                            {
                                <span class="badge bg-danger">⭐⭐⭐ Enterprise</span>
                            }
                            else if (Model.ServiceLevel == ServiceLevel.Premium)
                            {
                                <span class="badge bg-warning text-dark">⭐⭐ Premium</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">⭐ Standard</span>
                            }
                        </dd>

                        <dt class="col-sm-4">Contract Value (USD)</dt>
                        <dd class="col-sm-8">$ @Model.ContractValue.ToString("N2")</dd>

                        <dt class="col-sm-4">Auto-Renew</dt>
                        <dd class="col-sm-8">@(Model.AutoRenew ? "Yes" : "No")</dd>

                        <dt class="col-sm-4">Notice Period</dt>
                        <dd class="col-sm-8">@Model.NoticePeriodDays days</dd>

                        @if (!string.IsNullOrEmpty(Model.TermsAndConditions))
                        {
                            <dt class="col-sm-4">Terms & Conditions</dt>
                            <dd class="col-sm-8">@Model.TermsAndConditions</dd>
                        }

                        @if (!string.IsNullOrEmpty(Model.SpecialClauses))
                        {
                            <dt class="col-sm-4">Special Clauses</dt>
                            <dd class="col-sm-8">@Model.SpecialClauses</dd>
                        }

                        @if (!string.IsNullOrEmpty(Model.SignedAgreementPath))
                        {
                            <dt class="col-sm-4">Signed Agreement</dt>
                            <dd class="col-sm-8">
                                <a href="@Model.SignedAgreementPath" target="_blank" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-file-pdf"></i> View PDF
                                </a>
                            </dd>
                        }
                    </dl>

                    <hr />

                    <!-- Service Requests Section -->
                    <h5><i class="bi bi-truck"></i> Service Requests</h5>
                    @if (Model.ServiceRequests != null && Model.ServiceRequests.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Tracking #</th>
                                        <th>Description</th>
                                        <th>Amount (ZAR)</th>
                                        <th>Status</th>
                                        <th>Date</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var sr in Model.ServiceRequests.OrderByDescending(s => s.CreatedAt))
                                    {
                                        <tr>
                                            <td>@sr.TrackingNumber</td>
                                            <td>@(sr.Description.Length > 30 ? sr.Description.Substring(0, 30) + "..." : sr.Description)</td>
                                            <td>R @sr.AmountZAR.ToString("N2")</td>
                                            <td>@sr.Status</td>
                                            <td>@sr.RequestDate.ToShortDateString()</td>
                                            <td>
                                                <a asp-controller="ServiceRequests" asp-action="Details" asp-route-id="@sr.Id" class="btn btn-sm btn-info">View</a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">No service requests for this contract.</p>
                        @if (Model.CanCreateServiceRequest())
                        {
                            <a asp-controller="ServiceRequests" asp-action="Create" class="btn btn-sm btn-primary">
                                <i class="bi bi-plus-circle"></i> Create First Service Request
                            </a>
                        }
                    }

                    <div class="mt-4 d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
                        <div>
                            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
                            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">Delete</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>