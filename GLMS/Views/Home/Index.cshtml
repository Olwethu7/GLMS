@{
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid">
    <!-- Welcome Section -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="bg-gradient-primary text-white rounded p-4 shadow" style="background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);">
                <h1 class="display-4">
                    <i class="bi bi-box-seam"></i> Global Logistics Management System
                </h1>
                <p class="lead">Welcome to TechMove Logistics - Manage contracts, service requests, and international shipments</p>
                <hr class="my-3 bg-white">
                <p>Today's date: @DateTime.Now.ToString("dddd, MMMM dd, yyyy")</p>
            </div>
        </div>
    </div>

    <!-- Statistics Cards -->
    <div class="row mb-4">
        <div class="col-md-3 mb-3">
            <div class="card text-white bg-primary shadow h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title">Total Clients</h6>
                            <h2 class="display-4">@ViewBag.TotalClients</h2>
                        </div>
                        <i class="bi bi-people-fill fs-1 opacity-50"></i>
                    </div>
                </div>
                <div class="card-footer bg-transparent border-0">
                    <a asp-controller="Clients" asp-action="Index" class="text-white text-decoration-none">
                        View All Clients <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card text-white bg-success shadow h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title">Total Contracts</h6>
                            <h2 class="display-4">@ViewBag.TotalContracts</h2>
                            <small>@ViewBag.ActiveContracts Active</small>
                        </div>
                        <i class="bi bi-file-earmark-text-fill fs-1 opacity-50"></i>
                    </div>
                </div>
                <div class="card-footer bg-transparent border-0">
                    <a asp-controller="Contracts" asp-action="Index" class="text-white text-decoration-none">
                        Manage Contracts <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card text-white bg-info shadow h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title">Service Requests</h6>
                            <h2 class="display-4">@ViewBag.TotalServiceRequests</h2>
                            <small>@ViewBag.PendingRequests Pending</small>
                        </div>
                        <i class="bi bi-truck fs-1 opacity-50"></i>
                    </div>
                </div>
                <div class="card-footer bg-transparent border-0">
                    <a asp-controller="ServiceRequests" asp-action="Index" class="text-white text-decoration-none">
                        View Requests <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card text-white bg-warning shadow h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title">Exchange Rate</h6>
                            <h2 class="display-4" id="liveRate">--</h2>
                            <small>USD to ZAR</small>
                        </div>
                        <i class="bi bi-currency-exchange fs-1 opacity-50"></i>
                    </div>
                </div>
                <div class="card-footer bg-transparent border-0">
                    <button onclick="refreshRate()" class="btn btn-sm btn-light">
                        <i class="bi bi-arrow-repeat"></i> Refresh Rate
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Activity Tables -->
    <div class="row">
        <div class="col-md-6 mb-4">
            <div class="card shadow">
                <div class="card-header bg-dark text-white">
                    <h5><i class="bi bi-file-earmark-text"></i> Recent Contracts</h5>
                </div>
                <div class="card-body">
                    @if (ViewBag.RecentContracts != null && ViewBag.RecentContracts.Count > 0)
                    {
                        <div class="table-responsive">
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Reference</th>
                                        <th>Client</th>
                                        <th>Status</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var contract in ViewBag.RecentContracts)
                                    {
                                        <tr>
                                            <td>@contract.ContractReference</td>
                                            <td>@contract.Client?.Name</td>
                                            <td>
                                                @{
                                                    var statusColor = contract.GetStatusColor();
                                                }
                                                <span class="badge bg-@statusColor">@contract.Status</span>
                                            </td>
                                            <td>
                                                <a asp-controller="Contracts" asp-action="Details" asp-route-id="@contract.Id" class="btn btn-sm btn-info">View</a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">No contracts found.</p>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-6 mb-4">
            <div class="card shadow">
                <div class="card-header bg-dark text-white">
                    <h5><i class="bi bi-truck"></i> Recent Service Requests</h5>
                </div>
                <div class="card-body">
                    @if (ViewBag.RecentRequests != null && ViewBag.RecentRequests.Count > 0)
                    {
                        <div class="table-responsive">
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Tracking</th>
                                        <th>Contract</th>
                                        <th>Status</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var request in ViewBag.RecentRequests)
                                    {
                                        <tr>
                                            <td>@request.TrackingNumber</td>
                                            <td>@request.Contract?.ContractReference</td>
                                            <td><span class="badge bg-secondary">@request.Status</span></td>
                                            <td>
                                                <a asp-controller="ServiceRequests" asp-action="Details" asp-route-id="@request.Id" class="btn btn-sm btn-info">View</a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">No service requests found.</p>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="row">
        <div class="col-12">
            <div class="card shadow">
                <div class="card-header bg-secondary text-white">
                    <h5><i class="bi bi-lightning-charge"></i> Quick Actions</h5>
                </div>
                <div class="card-body">
                    <div class="row text-center">
                        <div class="col-md-3 mb-2">
                            <a asp-controller="Clients" asp-action="Create" class="btn btn-outline-primary w-100 py-3">
                                <i class="bi bi-person-plus fs-3 d-block"></i>
                                Add Client
                            </a>
                        </div>
                        <div class="col-md-3 mb-2">
                            <a asp-controller="Contracts" asp-action="Create" class="btn btn-outline-success w-100 py-3">
                                <i class="bi bi-file-earmark-plus fs-3 d-block"></i>
                                Create Contract
                            </a>
                        </div>
                        <div class="col-md-3 mb-2">
                            <a asp-controller="ServiceRequests" asp-action="Create" class="btn btn-outline-info w-100 py-3">
                                <i class="bi bi-plus-circle fs-3 d-block"></i>
                                New Service Request
                            </a>
                        </div>
                        <div class="col-md-3 mb-2">
                            <a asp-controller="Contracts" asp-action="Index" class="btn btn-outline-warning w-100 py-3">
                                <i class="bi bi-search fs-3 d-block"></i>
                                Search Contracts
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    async function refreshRate() {
        try {
            const response = await fetch('https://api.exchangerate-api.com/v4/latest/USD');
            const data = await response.json();
            const rate = data.rates.ZAR;
            document.getElementById('liveRate').innerText = rate.toFixed(2);
        } catch (error) {
            document.getElementById('liveRate').innerText = '19.50';
        }
    }

    refreshRate();
    setInterval(refreshRate, 300000); // Refresh every 5 minutes
</script>