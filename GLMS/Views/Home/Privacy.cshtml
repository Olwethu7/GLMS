@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h3><i class="bi bi-shield-lock"></i> Privacy Policy</h3>
                </div>
                <div class="card-body">
                    <h5>Global Logistics Management System (GLMS)</h5>
                    <p>Last updated: @DateTime.Now.ToShortDateString()</p>

                    <h6>1. Data Collection</h6>
                    <p>We collect client information, contract details, and service request data to facilitate logistics management.</p>

                    <h6>2. Data Security</h6>
                    <p>All data is encrypted and stored securely. File uploads are validated and stored with unique identifiers.</p>

                    <h6>3. Third-Party Services</h6>
                    <p>We use ExchangeRate-API for currency conversion. No personal data is shared.</p>

                    <h6>4. Your Rights</h6>
                    <p>You have the right to access, modify, or delete your data at any time.</p>

                    <hr />
                    <p class="text-muted small">© 2026 TechMove Logistics - All Rights Reserved</p>
                </div>
            </div>
        </div>
    </div>
</div>