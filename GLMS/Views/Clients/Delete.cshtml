@model GLMS.Models.Client

@{
    ViewData["Title"] = "Delete Client";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-danger text-white">
                    <h3><i class="bi bi-exclamation-triangle"></i> Delete Client</h3>
                </div>
                <div class="card-body">
                    <div class="alert alert-warning">
                        <i class="bi bi-info-circle"></i> Are you sure you want to delete this client?
                        <strong>This action cannot be undone!</strong>
                    </div>

                    <dl class="row">
                        <dt class="col-sm-4">Name</dt>
                        <dd class="col-sm-8">@Model.Name</dd>

                        <dt class="col-sm-4">Email</dt>
                        <dd class="col-sm-8">@Model.Email</dd>

                        <dt class="col-sm-4">Region</dt>
                        <dd class="col-sm-8">@Model.Region</dd>

                        <dt class="col-sm-4">Contracts</dt>
                        <dd class="col-sm-8">@Model.Contracts.Count</dd>
                    </dl>

                    @if (Model.Contracts.Any())
                    {
                        <div class="alert alert-danger">
                            <i class="bi bi-ban"></i> Cannot delete client with existing contracts.
                            Please delete or reassign contracts first.
                        </div>
                    }

                    <form asp-action="Delete">
                        <input type="hidden" asp-for="Id" />
                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                            <button type="submit" class="btn btn-danger" @(Model.Contracts.Any() ? "disabled" : "")>
                                <i class="bi bi-trash"></i> Confirm Delete
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>