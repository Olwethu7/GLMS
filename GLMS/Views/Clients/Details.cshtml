@model GLMS.Models.Client

@{
    ViewData["Title"] = "Client Details";
}

<div class="container">
    <div class="row">
        <div class="col-md-8 mx-auto">
            <div class="card shadow">
                <div class="card-header bg-info text-white">
                    <h3><i class="bi bi-building"></i> Client Details</h3>
                </div>
                <div class="card-body">

                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="bi bi-check-circle-fill"></i> @TempData["Success"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <dl class="row">
                        <dt class="col-sm-3">Name</dt>
                        <dd class="col-sm-9">@Model.Name</dd>

                        <dt class="col-sm-3">Email</dt>
                        <dd class="col-sm-9">@Model.Email</dd>

                        <dt class="col-sm-3">Phone</dt>
                        <dd class="col-sm-9">@Model.Phone</dd>

                        <dt class="col-sm-3">Address</dt>
                        <dd class="col-sm-9">@Model.Address</dd>

                        <dt class="col-sm-3">Region</dt>
                        <dd class="col-sm-9">
                            <span class="badge bg-info">@Model.Region</span>
                        </dd>

                        <dt class="col-sm-3">Tax ID / VAT</dt>
                        <dd class="col-sm-9">@(string.IsNullOrEmpty(Model.TaxId) ? "N/A" : Model.TaxId)</dd>

                        <dt class="col-sm-3">Status</dt>
                        <dd class="col-sm-9">
                            @if (Model.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Inactive</span>
                            }
                        </dd>

                        <dt class="col-sm-3">Created Date</dt>
                        <dd class="col-sm-9">@Model.CreatedAt.ToString("f")</dd>

                        <dt class="col-sm-3">Last Modified</dt>
                        <dd class="col-sm-9">@(Model.UpdatedAt?.ToString("f") ?? "Never")</dd>
                    </dl>

                    <hr />

                    <h5><i class="bi bi-file-earmark-text"></i> Contracts (@Model.Contracts.Count)</h5>

                    @if (Model.Contracts != null && Model.Contracts.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-sm table-hover">
                                <thead>
                                    <tr>
                                        <th>Reference</th>
                                        <th>Start Date</th>
                                        <th>End Date</th>
                                        <th>Status</th>
                                        <th>Value (USD)</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var contract in Model.Contracts)
                                    {
                                        <tr>
                                            <td>@contract.ContractReference</td>
                                            <td>@contract.StartDate.ToShortDateString()</td>
                                            <td>@contract.EndDate.ToShortDateString()</td>
                                            <td>
                                                <span class="badge bg-@(contract.Status == ContractStatus.Active ? "success" : "secondary")">
                                                    @contract.Status
                                                </span>
                                            </td>
                                            <td>$ @contract.ContractValue.ToString("N2")</td>
                                            <td>
                                                <a asp-controller="Contracts" asp-action="Details" asp-route-id="@contract.Id" class="btn btn-sm btn-info">View</a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">No contracts for this client.</p>
                        <a asp-controller="Contracts" asp-action="Create" class="btn btn-sm btn-primary">
                            <i class="bi bi-plus-circle"></i> Create First Contract
                        </a>
                    }

                    <hr />

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-arrow-left"></i> Back to List
                        </a>
                        <div>
                            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                                <i class="bi bi-pencil"></i> Edit
                            </a>
                            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">
                                <i class="bi bi-trash"></i> Delete
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>